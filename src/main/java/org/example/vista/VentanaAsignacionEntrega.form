<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="org.example.vista.VentanaAsignacionEntrega">
  <grid id="27dc6" binding="VentanaAsignacionEntrega" layout-manager="GridLayoutManager" row-count="3" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="10">
    <margin top="18" left="20" bottom="18" right="20"/>
    <constraints>
      <xy x="20" y="20" width="820" height="480"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <component id="titulo" class="javax.swing.JLabel" binding="lblTitulo">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <font name="Segoe UI" size="20" style="1"/>
          <text value="Asignación e inicio de entregas"/>
        </properties>
      </component>
      <scrollpane id="scrollEntrega">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false">
            <preferred-size width="760" height="310"/>
          </grid>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="tabla" class="javax.swing.JTable" binding="tblPedidos">
            <constraints/>
            <properties/>
          </component>
        </children>
      </scrollpane>
      <grid id="acciones" layout-manager="GridLayoutManager" row-count="1" column-count="4" same-size-horizontally="false" same-size-vertically="false" hgap="8" vgap="-1">
        <margin top="4" left="0" bottom="0" right="0"/>
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="lblrep" class="javax.swing.JLabel" binding="lblRepartidor">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Repartidor:"/>
            </properties>
          </component>
          <component id="cmbrep" class="javax.swing.JComboBox" binding="cmbRepartidor">
            <constraints>
              <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="2" anchor="8" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="140" height="-1"/>
              </grid>
            </constraints>
            <properties/>
          </component>
          <component id="iniciar" class="javax.swing.JButton" binding="btnIniciarEntrega">
            <constraints>
              <grid row="0" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Asignar e iniciar entrega"/>
            </properties>
          </component>
          <component id="refrescar" class="javax.swing.JButton" binding="btnRefrescar">
            <constraints>
              <grid row="0" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Refrescar"/>
            </properties>
          </component>
        </children>
      </grid>
    </children>
  </grid>

</form>
