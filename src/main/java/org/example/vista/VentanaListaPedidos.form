<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="org.example.vista.VentanaListaPedidos">
  <grid id="27dc6" binding="VentanaListaPedidos" layout-manager="GridLayoutManager" row-count="3" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="10">
    <margin top="18" left="20" bottom="18" right="20"/>
    <constraints>
      <xy x="20" y="20" width="820" height="460"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <component id="titulo" class="javax.swing.JLabel" binding="lblTitulo">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <font name="Segoe UI" size="20" style="1"/>
          <text value="Pedidos registrados"/>
        </properties>
      </component>
      <scrollpane id="scrollLista">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false">
            <preferred-size width="760" height="300"/>
          </grid>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="tabla" class="javax.swing.JTable" binding="tblPedidos">
            <constraints/>
            <properties/>
          </component>
        </children>
      </scrollpane>
      <component id="refrescar" class="javax.swing.JButton" binding="btnRefrescar">
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false">
            <preferred-size width="180" height="35"/>
          </grid>
        </constraints>
        <properties>
          <text value="Refrescar tabla"/>
        </properties>
      </component>
    </children>
  </grid>

</form>
